{
  "manifest_version": 3,
  "name": "Ex-Changer — Download Converter",
  "short_name": "Ex-Changer",
  "version": "1.0.0",
  "description": "Auto-converts downloads: WebP/AVIF to PNG, OGG/Opus/MPEG to MP3. Fixes Fandom wiki 'latest.webp' and 'latest.mpeg' files.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Ex-Changer",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "downloads",
    "offscreen",
    "storage",
    "contextMenus",
    "notifications",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
